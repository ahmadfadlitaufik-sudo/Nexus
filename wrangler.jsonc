{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nama Worker = subdomain default: https://nexus-client-hub.<akun>.workers.dev
  "name": "nexus-client-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    // Semua URL yang bukan file -> index.html (aplikasi satu halaman / SPA).
    "not_found_handling": "single-page-application",
    // Permintaan /api/* selalu diproses Worker terlebih dahulu.
    "run_worker_first": ["/api/*"]
  },
  // Database Cloudflare D1. Struktur tabel ada di folder migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-db",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "ahmadfadlitaufik@gmail.com",
    "GEMINI_MODEL": "gemini-3.8-flash"
  },
  "observability": { "enabled": true }
  // Rahasia (set di dashboard Cloudflare > Worker > Settings > Variables and Secrets,
  // atau `npx wrangler secret put NAMA`):
  //   GEMINI_API_KEY        - fitur ringkasan AI
  //   OWNER_SETUP_CODE      - kode untuk membuat akun owner pertama dengan email + kata sandi
  //   GOOGLE_CLIENT_ID      - (opsional) login Google
  //   GOOGLE_CLIENT_SECRET  - (opsional) login Google
}
