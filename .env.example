# GEMINI_API_KEY: wajib untuk fitur ringkasan AI (server lokal `npm run dev`).
# Di Cloudflare, set sebagai secret: npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Opsional: model Gemini yang dipakai (default ada di api/summarize.ts).
# GEMINI_MODEL="gemini-3.8-flash"

# Mode demo: login tanpa password + akun & data contoh. HANYA untuk uji coba lokal.
# VITE_DEMO_MODE="true"

# APP_URL: URL tempat aplikasi di-hosting (dipakai AI Studio).
APP_URL="MY_APP_URL"
