rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'Ahmadfadlitaufik@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner')
      );
    }

    function isConsultant() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'consultant' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'konsultan'
        )
      );
    }

    function isTimGrup() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tim_grup'
      );
    }

    function isTimKonten() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tim_konten'
      );
    }

    function isStaffOrTeam() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tim_grup' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tim_konten' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staf_operasional'
        )
      );
    }

    function isClientUser(clientId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'client' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'klien'
        ) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId == clientId
      );
    }

    // Allow read for users to load team profiles & demo selector
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Clients collection
    match /clients/{clientId} {
      allow read: if true;
      allow write: if true;
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if true;
      allow write: if true;
    }

    // Group Members collection
    match /group_members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    // Group Attendance collection
    match /group_attendance/{attendanceId} {
      allow read: if true;
      allow write: if true;
    }

    // Group Announcements collection
    match /group_announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Client Consultants assignment collection
    match /client_consultants/{ccId} {
      allow read: if true;
      allow write: if true;
    }

    // Enrollments collection
    match /enrollments/{enrollmentId} {
      allow read: if true;
      allow write: if true;
    }

    // Programs: Service packages
    match /programs/{programId} {
      allow read: if true;
      allow write: if true;
    }

    // Sessions (catatanDibagikan is visible)
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if true;
    }

    // Session Internals: STRICTLY RESTRICTED to internal team
    match /session_internals/{sessionId} {
      allow read, write: if true;
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }

    // Roadmap items
    match /roadmap_items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // KPIs
    match /kpis/{kpiId} {
      allow read: if true;
      allow write: if true;
    }

    // Diagnoses
    match /diagnoses/{diagnosisId} {
      allow read: if true;
      allow write: if true;
    }

    // Documents
    match /documents/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow read: if true;
      allow write: if true;
    }

    // Content Items: Content Calendar & Material Library
    match /content_items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Content Consents: Client case study publication consent
    match /content_consents/{consentId} {
      allow read: if true;
      allow write: if true;
    }

    // Team Checkins: Daily WFA standup
    match /team_checkins/{checkinId} {
      allow read: if true;
      allow write: if true;
    }

    // Plan Items: Daily priorities and work plans
    match /plan_items/{planId} {
      allow read: if true;
      allow write: if true;
    }

    // Activity log
    match /activity_log/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
